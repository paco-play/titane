# =========================
# Dependencies
# =========================
node_modules/
npm-debug.log*
yarn-error.log*
yarn.lock
package-lock.json

# =========================
# Build & Generated folders
# =========================
# Core
packages/**/dist/
packages/**/build/

# Incremental compilation caches: derived from the sources, and a guaranteed
# conflict on every merge if tracked.
*.tsbuildinfo

# Nuxt. The editor also ships its own .gitignore; these patterns keep the root
# accurate for any future app under apps/.
apps/**/.nuxt/
apps/**/.output/
apps/**/.nitro/
apps/**/.data/
apps/**/.cache/
apps/**/dist/
apps/**/public/_nuxt/

# =========================
# Environment variables
# =========================
.env
.env.*
!.env.example

# =========================
# Logs & OS
# =========================
logs
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# =========================
# IDE
# =========================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.agents/